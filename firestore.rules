rules_version = '2';

// Règles de sécurité Firestore de Navette Profs.
// À copier dans la console Firebase : Firestore Database > Règles > Publier.
//
// Principe : chaque enseignant a son propre abonnement (subscriptions/{uid}).
// Il n'accède aux données de son établissement que si son abonnement est valide :
// période d'essai de 7 jours après la création du compte, ou période payée
// activée par un administrateur. Seul un administrateur (document admins/{uid})
// peut activer un abonnement ou créer un établissement.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function myProfile() {
      return get(/databases/$(database)/documents/teachers/$(request.auth.uid)).data;
    }

    function mySubscription() {
      return get(/databases/$(database)/documents/subscriptions/$(request.auth.uid)).data;
    }

    // Abonnement valide : non suspendu, et soit payé, soit encore en essai (7 jours).
    function subscriptionOk() {
      return mySubscription().active == true && (
        mySubscription().paidUntilMillis > request.time.toMillis()
        || mySubscription().createdAt.toMillis() + 604800000 > request.time.toMillis()
      );
    }

    // L'utilisateur est rattaché à l'établissement [id] et son abonnement est valide.
    function memberOf(id) {
      return id != ''
        && myProfile().establishmentId == id
        && subscriptionOk();
    }

    // Administrateurs : créés à la main dans la console Firebase uniquement.
    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
    }

    // Abonnement individuel. L'enseignant peut seulement créer le sien, une fois,
    // à la date du serveur (début de l'essai) et sans période payée. Lui seul et
    // l'administrateur peuvent le lire ; seul l'administrateur peut le modifier.
    match /subscriptions/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create: if isAdmin() || (
        signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email', 'active', 'paidUntilMillis', 'createdAt'])
        && request.resource.data.active == true
        && request.resource.data.paidUntilMillis == 0
        && request.resource.data.createdAt == request.time
        && request.resource.data.email == request.auth.token.email
      );
      allow update, delete: if isAdmin();
    }

    // Codes d'accès : lisibles un par un (il faut connaître le code), jamais listables.
    match /licenseCodes/{code} {
      allow get: if signedIn();
      allow list, write: if isAdmin();
    }

    match /establishments/{id} {
      allow get: if signedIn();
      allow list, write: if isAdmin();
    }

    match /teachers/{uid} {
      // Rejoindre un établissement : il faut connaître son code d'accès.
      function joining() {
        let d = request.resource.data;
        return get(/databases/$(database)/documents/licenseCodes/$(d.joinCode)).data.establishmentId
          == d.establishmentId;
      }

      allow read: if signedIn() && (
        request.auth.uid == uid
        || isAdmin()
        || memberOf(resource.data.establishmentId)
      );
      allow delete: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid && (
        request.resource.data.get('establishmentId', '') == ''
        || joining()
      );
      allow update: if signedIn() && request.auth.uid == uid && (
        request.resource.data.get('establishmentId', '') == resource.data.get('establishmentId', '')
        || request.resource.data.get('establishmentId', '') == ''
        || joining()
      );
    }

    match /groups/{groupId} {
      allow read: if signedIn() && memberOf(resource.data.establishmentId);
      allow create: if signedIn()
        && request.resource.data.driverId == request.auth.uid
        && memberOf(request.resource.data.establishmentId);
      allow update: if signedIn()
        && resource.data.driverId == request.auth.uid
        && request.resource.data.driverId == resource.data.driverId
        && request.resource.data.establishmentId == resource.data.establishmentId
        && memberOf(resource.data.establishmentId);
      allow delete: if signedIn() && resource.data.driverId == request.auth.uid;
    }
  }
}
